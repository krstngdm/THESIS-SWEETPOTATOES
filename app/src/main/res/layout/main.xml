<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light_green">

    <!-- Main content -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="24dp">

            <!-- Model Status Indicator -->

            <!-- Top content -->
            <LinearLayout
                android:id="@+id/modelStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_corner_gray"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/modelStatusIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_model_ready" />

                <TextView
                    android:id="@+id/modelStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Ready"
                    android:textColor="@color/green"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/modelStatusContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/uploadButton"
                app:layout_constraintVertical_bias="0.5">

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginBottom="32dp"
                    android:src="@drawable/grow_sight_leaf"
                    android:contentDescription="@string/image_preview_desc" />

                <TextView
                    android:id="@+id/uploadTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:text="@string/upload_title"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/green"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Upload Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadButton"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:text="@string/upload_image"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/gradient_background"
                app:backgroundTint="@null"
                app:layout_constraintTop_toBottomOf="@id/topContent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/infoContainer" />

            <!-- Info Container -->
            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ViewFlipper
                    android:id="@+id/flipperContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:autoStart="true"
                    android:flipInterval="5000"
                    android:inAnimation="@android:anim/fade_in"
                    android:outAnimation="@android:anim/fade_out">

                    <TextView
                        android:id="@+id/legalText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/legal_text"
                        android:textAlignment="center"
                        android:textColor="@color/gray"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/privacyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/privacy_text"
                        android:textAlignment="center"
                        android:textColor="@color/gray"
                        android:textSize="12sp" />
                </ViewFlipper>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Burger/Menu Button -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />
    </RelativeLayout>

    <!-- Right Drawer -->
    <RelativeLayout
        android:id="@+id/rightDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white">

        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_light_green"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plantations"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to open, long press for options"
                android:textColor="@color/gray"
                android:textSize="12sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/conversationListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/headerContainer"
            android:layout_above="@id/bottomHintContainer"
            android:divider="@color/divider_gray"
            android:dividerHeight="1dp"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/bottomHintContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/divider_gray"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Swipe or tap outside to close"
                android:textColor="@color/gray"
                android:textSize="12sp" />
        </LinearLayout>
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>
