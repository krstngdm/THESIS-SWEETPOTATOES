<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light_green">

    <!-- ── Top bar ───────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/homeTopBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@color/green_deep"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/logoButton"
            android:layout_width="140dp"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="GrowSight"
            android:scaleType="fitStart"
            android:src="@drawable/grow_white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- AI status chip — white translucent on green_deep bar -->
        <LinearLayout
            android:id="@+id/modelStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_white_translucent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <ImageView
                android:id="@+id/modelStatusIndicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/check_brown" />

            <TextView
                android:id="@+id/modelStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:text="AI Ready"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavBar"
        android:layout_below="@id/homeTopBar"
        android:layout_marginTop="12dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Section header: My Plantations ─────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionHeaderPlantations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/rounded_corner_brown_4"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/sectionLabelPlantations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extrabold"
                    android:letterSpacing="0.06"
                    android:text="MY PLANTATIONS"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/chevronPlantations"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:rotation="0"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <!-- ── Plantation grid ─────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionBodyPlantations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="0dp">

                <!-- Empty state — hidden when plantations exist -->

                <TextView
                    android:id="@+id/plantationsEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_extrabold"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="No plantations yet.\nTap + New Plantation to get started."
                    android:textColor="@color/gray"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <GridView
                    android:id="@+id/plantationGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:columnWidth="0dp"
                    android:gravity="fill"
                    android:horizontalSpacing="10dp"
                    android:nestedScrollingEnabled="false"
                    android:numColumns="2"
                    android:paddingHorizontal="10dp"
                    android:scrollbars="none"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="10dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/plantationButtonSpacer"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ── Section header: Recent Activity ────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionHeaderActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_corner_brown_4"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/sectionLabelActivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extrabold"
                    android:letterSpacing="0.06"
                    android:text="RECENT ACTIVITY"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/chevronActivity"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:rotation="0"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionBodyActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Activity card — white surface, DCDECA border -->
                <LinearLayout
                    android:id="@+id/activityCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_bottom_rounded"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/activityContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Empty state — updated to match instructionText style -->
                        <TextView
                            android:id="@+id/activityEmptyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="No activity yet.\nStart scanning to see your history here."
                            android:textColor="@color/gray"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Section header: Quick Scans ───────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionHeaderQuickScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/rounded_corner_brown_4"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/sectionLabelQuickScans"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_extrabold"
                    android:letterSpacing="0.06"
                    android:text="QUICK SCANS"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/chevronQuickScans"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="14dp"
                    android:rotation="0"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>

            <!-- Quick Scans card — white surface -->
            <LinearLayout
                android:id="@+id/sectionBodyQuickScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/quickScansCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/card_bottom_rounded"
                    android:elevation="2dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/quickScansContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Empty state — updated to match instructionText style -->
                        <TextView
                            android:id="@+id/quickScansEmptyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text='No quick scans yet.\nTap "Quick Scan" to scan a plant.'
                            android:textColor="@color/gray"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── New Plantation button — green primary action ─────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/newPlantationButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_above="@id/bottomNavBar"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:elevation="3dp"
        android:fontFamily="@font/nunito_extrabold"
        android:text="New Plantation"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@null"
        app:cornerRadius="16dp"
        app:icon="@drawable/upload"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:iconSize="12dp"
        app:iconPadding="8dp" />

    <!-- ── Bottom nav — white bg, green_deep active state ────────────── -->
    <LinearLayout
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="40dp"
                android:layout_height="24dp"
                android:background="@drawable/nav_active_bg"
                android:contentDescription="Home"
                android:elevation="1dp"
                android:padding="3dp"
                android:paddingHorizontal="2dp"
                android:src="@drawable/ic_home_2" />

            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_bold"
                android:text="Home"
                android:textColor="@color/green"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlantations"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/navPlantationsIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="My Plantations"
                android:elevation="3dp"
                android:padding="4dp"
                android:src="@drawable/plantation_3" />

            <TextView
                android:id="@+id/navPlantationsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_semibold"
                android:text="Plantations"
                android:textColor="@color/greenGray"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/navCameraIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="Camera"
                android:elevation="3dp"
                android:padding="5dp"
                android:src="@drawable/ic_quick_scan" />

            <TextView
                android:id="@+id/navCameraLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_semibold"
                android:text="Quick Scan"
                android:textColor="@color/greenGray"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>