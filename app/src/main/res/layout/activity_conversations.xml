<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light_green">

    <!-- Main content (no gravity here) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- Top Banner -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBanner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/gray"
            android:layout_marginTop="60dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Edit button at start -->
            <ImageButton
                android:id="@+id/editTitleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Conversation title centered -->
            <TextView
                android:id="@+id/conversationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testing texting"
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <!-- Logo -->
        <ImageButton
            android:id="@+id/logoButton"
            android:layout_width="165dp"
            android:layout_height="48dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/growsight"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            />

        <!-- Burger button -->
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="24dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="Menu" />
        <!-- Scrollable conversation area -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomBar"
            android:layout_marginTop="115dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Instruction Text -->

                <TextView
                    android:id="@+id/instructionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="200dp"
                    android:layout_marginBottom="40dp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Upload the Images of your own sweet potato crop"
                    android:textColor="@color/black"
                    android:textSize="25sp" />

                <LinearLayout
                    android:id="@+id/uploadedImagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:dividerPadding="8dp"
                    android:showDividers="none" />

                <!-- Messages container for conversation history -->
                <LinearLayout
                    android:id="@+id/messagesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:padding="8dp" />


                <com.github.ybq.android.spinkit.SpinKitView
                    android:id="@+id/wave_loader"
                    style="@style/SpinKitView.Wave"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    app:SpinKit_Color="@color/gd_1"
                    tools:ignore="MissingClass" />
            </LinearLayout>
        </ScrollView>

        <!-- Fixed bottom bar -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_light_green"
            android:layout_alignParentBottom="true"
            android:elevation="8dp">

            <!-- Preview of selected images -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:padding="8dp"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/previewContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </HorizontalScrollView>

            <!-- Action buttons row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/rounded_top_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <!-- Camera -->
                <ImageButton
                    android:id="@+id/cameraButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Take a picture"
                    android:src="@drawable/camera" />

                <!-- Upload -->
                <ImageButton
                    android:id="@+id/uploadButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Upload from gallery"
                    android:src="@drawable/upload" />

                <!-- Delete -->
                <ImageButton
                    android:id="@+id/deleteButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete selected"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone" />

                <!-- Note -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Note: You can Upload up to 5 Images at once"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <!-- Send -->
                <ImageButton
                    android:id="@+id/sendButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_send"
                    android:contentDescription="Send"
                    android:background="@drawable/gradient_background"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Right-side drawer -->
    <LinearLayout
        android:id="@+id/rightDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_light_green"
            android:padding="16dp">

            <!-- Left side: Vertical TextViews -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Plantations"
                    android:textColor="@android:color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical" />

                <TextView
                    android:id="@+id/drawerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to open, long press for options"
                    android:textColor="@color/gray"
                    android:textSize="12sp"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <!-- Right side: Add Conversation Button -->
            <ImageButton
                android:id="@+id/addConversationButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/upload_dark"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add new conversation"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <ListView
            android:id="@+id/conversationListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/divider_gray"
            android:dividerHeight="1dp"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:fastScrollEnabled="true" />
        <!-- Drawer Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/divider_gray"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swipe or tap outside to close"
                android:textColor="@color/gray"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
