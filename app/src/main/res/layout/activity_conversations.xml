<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_conversations.xml
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg_light_green">

    <!-- ── Main content ──────────────────────────────────────────────────── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBanner"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:paddingStart="16dp"
            android:elevation="8dp"
            android:background="@color/bg_light_green"
            android:paddingEnd="16dp">

            <!-- Logo -->
            <ImageButton
                android:id="@+id/logoButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="15dp"
                android:adjustViewBounds="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                android:src="@drawable/grow"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/editTitleButton"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit title"
                android:src="@drawable/ic_edit_3"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:scaleType="fitCenter"
                app:layout_constraintVertical_bias="0.483" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="10dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_home_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/conversationTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center"
                android:text="Title"
                android:textColor="@color/gray"
                android:textSize="20sp"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/editTitleButton"
                app:layout_constraintStart_toEndOf="@id/logoButton"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/plantationLocationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/DCDECA"
                android:textSize="10sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ── Week timeline strip — green_deep ──────────────────────────── -->
        <LinearLayout
            android:id="@+id/weekTimelineContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBanner"
            android:background="@color/green_deep"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:elevation="2dp">

            <HorizontalScrollView
                android:id="@+id/weekTimelineScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/weekTimelineRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ── Weather banner — warm amber tint ──────────────────────────── -->
        <LinearLayout
            android:id="@+id/weatherBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/weekTimelineContainer"
            android:background="#FFF3CD"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:translationZ="2dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="Location icon"
                android:src="@drawable/pin" />

            <TextView
                android:id="@+id/weatherBannerText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Location is off — weather-based recommendations unavailable"
                android:textColor="#856404"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/weatherBannerAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:text="Turn On"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ── Main body — scan grid ─────────────────────────────────────── -->
        <RelativeLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomBar"
            android:layout_below="@id/weekTimelineContainer"
            android:layout_marginTop="0dp">

            <!-- Instruction text — gray on bg_light_green -->
            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/nunito_extrabold"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/upload_title_ac"
                android:textColor="@color/gray"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Send-lock banner — warm amber -->
            <LinearLayout
                android:id="@+id/sendLockBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#FFF3CD"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="⏳"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sendLockTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="Next check-in not due yet"
                        android:textColor="#7A5500"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/sendLockCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_semibold"
                        android:textColor="#856404"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Scan grid ──────────────────────────────────────────────── -->


            <!-- Shimmer card -->
            <GridView
                android:id="@+id/scanGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/sendLockBanner"
                android:layout_marginTop="5dp"
                android:columnWidth="0dp"
                android:gravity="fill"
                android:horizontalSpacing="10dp"
                android:numColumns="3"
                android:padding="10dp"
                android:paddingBottom="24dp"
                android:clipToPadding="false"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="10dp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/shimmerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="60dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="125dp"
                            android:layout_height="125dp"
                            android:layout_marginBottom="5dp"
                            android:background="@drawable/shimmer_placeholder_rounded_8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginEnd="12dp"
                                android:background="@drawable/shimmer_placeholder_rounded" />

                            <View
                                android:layout_width="110dp"
                                android:layout_height="16dp"
                                android:layout_marginTop="8dp"
                                android:background="@color/shimmer_placeholder" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="110dp"
                                android:layout_height="21dp"
                                android:layout_marginTop="3dp"
                                android:background="@drawable/shimmer_placeholder_rounded_8dp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/DCDECA" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="10dp"
                            android:background="@color/shimmer_placeholder" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/shimmer_placeholder_rounded_6dp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="10dp"
                            android:layout_marginTop="12dp"
                            android:background="@color/shimmer_placeholder" />

                        <View
                            android:layout_width="310dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/shimmer_placeholder" />

                        <View
                            android:layout_width="180dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="6dp"
                            android:background="@color/shimmer_placeholder" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </androidx.cardview.widget.CardView>

            <com.github.ybq.android.spinkit.SpinKitView
                android:id="@+id/wave_loader"
                style="@style/SpinKitView.Wave"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="70dp"
                android:visibility="gone"
                app:SpinKit_Color="@color/green"
                tools:ignore="MissingClass" />

            <LinearLayout
                android:id="@+id/uploadedImagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/messagesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- ── Bottom bar — bg_light_green ───────────────────────────────── -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/bg_light_green"
            android:elevation="8dp"
            android:paddingTop="10dp"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/previewScrollView"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:overScrollMode="never"
                android:padding="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/previewContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewAllButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/gradient_background"
                android:fontFamily="@font/nunito_extrabold"
                android:text="View All"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />

            <!-- ── Normal input row (shown when unlocked) ────────────────────── -->

            <FrameLayout
                android:id="@+id/inputRowWrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_marginBottom="0dp">

                <LinearLayout
                    android:id="@+id/inputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:background="@drawable/test"
                    android:clipToOutline="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp">

                    <ImageButton
                        android:id="@+id/cameraButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/gradient_background"
                        android:contentDescription="Take a picture"
                        android:elevation="2dp"
                        android:src="@drawable/camera_4" />

                    <ImageButton
                        android:id="@+id/uploadButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/gradient_background"
                        android:contentDescription="Upload from gallery"
                        android:elevation="2dp"
                        android:src="@drawable/upload_2" />

                    <ImageButton
                        android:id="@+id/deleteButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Delete selected"
                        android:src="@drawable/ic_delete"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/sendHintText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_extrabold"
                        android:text="Capture or select image(s)"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_background"
                        android:contentDescription="Send"
                        android:elevation="3dp"
                        android:minHeight="20dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="15dp"
                        android:text="Send"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="start"
                        app:iconTint="@color/white" />
                </LinearLayout>

                <!-- Ring overlay lives HERE — same size as inputRow, drawn on top -->
                <com.ai.growsight.BorderAnimView
                    android:id="@+id/inputRowRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="fill"
                    android:visibility="gone"
                    app:cornerRadius="50dp" />

                <!-- ── Locked / cooldown row (shown when send is locked) ─────────── -->
                <LinearLayout
                    android:id="@+id/sendLockedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/rounded_lock_bg"
                    android:clipToOutline="true"
                    android:gravity="center_vertical"
                    android:minHeight="60dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:alpha="0.55"
                        android:contentDescription="Locked"
                        android:src="@drawable/ic_lock" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="Next check-in unlocks in"
                            android:textColor="@color/greenGray"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/sendLockTimeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:text="6d 0h remaining"
                            android:textColor="@color/gray"
                            android:textSize="15sp" />

                        <ProgressBar
                            android:id="@+id/sendLockProgressBar"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progress="0"
                            android:progressDrawable="@drawable/lock_progress_drawable" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Note text -->
            <LinearLayout
                android:id="@+id/uploadNoteContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Note: You can Upload up to 10 Images at once"
                    android:textAlignment="center"
                    android:textColor="@color/greenGray"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

    <!-- ── Right-side drawer — white bg, driedLeaf header ───────────────── -->
    <LinearLayout
        android:id="@+id/rightDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/driedLeaf"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="My Plantation"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drawerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text="Tap to open, long press for options"
                    android:textColor="@color/DCDECA"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/addConversationButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Add new conversation"
                android:visibility="gone"
                android:src="@drawable/upload_light" />
        </LinearLayout>

        <!-- Tab strip — same style as activity_plantation_list.xml -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/drawerTabLayout"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/driedLeaf"
            app:tabTextColor="@color/DCDECA"
            app:tabSelectedTextColor="@color/white"
            app:tabIndicatorColor="@color/white"
            app:tabIndicatorHeight="3dp"
            app:tabRippleColor="@null"
            app:tabTextAppearance="@style/TabTextAppearance" />

        <!-- Plantation list -->
        <ListView
            android:id="@+id/conversationListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/DCDECA"
            android:dividerHeight="1dp"
            android:fadeScrollbars="true"
            android:fastScrollEnabled="true"
            android:padding="8dp"
            android:scrollbars="vertical" />

        <!-- Quick Scan list -->
        <ListView
            android:id="@+id/drawerQuickScanListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/DCDECA"
            android:dividerHeight="1dp"
            android:fadeScrollbars="true"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- Empty state — shown when a tab has no items -->
        <LinearLayout
            android:id="@+id/drawerEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/drawerEmptyIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌱"
                android:textSize="36sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/drawerEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="No plantations yet"
                android:textColor="@color/greenGray"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Drawer footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/DCDECA"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Swipe or tap outside to close"
                android:textColor="@color/greenGray"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>