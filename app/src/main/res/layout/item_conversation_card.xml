<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <!-- Image Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/cardImageRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Stage Gradient Line with Arrow -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <!-- Gradient Line -->
        <View
            android:id="@+id/cardStageGradient"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/stage_gradient"/>

        <!-- Arrow Indicator -->
        <ImageView
            android:id="@+id/stageArrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="start|top"
            android:src="@drawable/ic_arrow_up"
            android:translationX="0dp"
            android:translationY="15dp"/>
    </FrameLayout>



    <!-- Diagnostic Report -->
    <TextView
        android:id="@+id/cardDiagnostic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diagnostic Report"
        android:textSize="14sp"
        android:textColor="@color/black"
        android:layout_marginBottom="4dp"/>

    <!-- Timestamp -->
    <TextView
        android:id="@+id/cardTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MM/DD/YYYY at hh:mm"
        android:textSize="12sp"
        android:textColor="@color/gray"
        android:gravity="center"/>
</LinearLayout>
