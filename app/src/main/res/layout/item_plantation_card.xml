<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:orientation="vertical">

        <!-- ── Thumbnail area ─────────────────────────────────────────────── -->
        <FrameLayout
            android:id="@+id/cardThumbContainer"
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <!-- Gradient background using brand gradient -->
            <ImageView
                android:id="@+id/cardThumbBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/card_thumb_placeholder_bg"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/cardThumbPlaceholderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alpha="0.95"
                android:src="@drawable/frame_2"
                android:contentDescription="No scan yet" />
            <!-- Latest scan thumbnail -->
            <ImageView
                android:id="@+id/cardThumbImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Latest scan"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Stage badge — top right — color set programmatically -->
            <TextView
                android:id="@+id/cardStageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/rounded_corner_gray"
                android:fontFamily="@font/nunito_extrabold"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="Not Ready"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- Week chips row — bottom left -->
            <LinearLayout
                android:id="@+id/cardWeekChipsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:gravity="center_vertical"
                android:orientation="vertical" />

        </FrameLayout>

        <!-- ── Card body — white surface ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Plantation name — dark warm text -->
            <TextView
                android:id="@+id/cardPlantationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_extrabold"
                android:maxLines="1"
                android:text="Plantation Name"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- Location — muted greenGray -->
            <TextView
                android:id="@+id/cardPlantationLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_semibold"
                android:maxLines="1"
                android:textColor="@color/greenGray"
                android:textSize="9sp"
                android:visibility="gone" />

            <!-- Week · scans meta — muted greenGray -->
            <TextView
                android:id="@+id/cardPlantationMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/nunito_semibold"
                android:text="Week 1 · 0 scans"
                android:textColor="@color/greenGray"
                android:textSize="10sp" />

            <!-- ── Progress bar — crop age vs harvest week ─────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <!-- Labels: current week left, target right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cardProgressLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="Wk 1"
                        android:textColor="@color/greenGray"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/cardProgressLabelEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="Wk 22"
                        android:textColor="@color/greenGray"
                        android:textSize="8sp" />
                </LinearLayout>

                <!-- Track: DCDECA, fill set programmatically to match stage color -->
                <ProgressBar
                    android:id="@+id/cardProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:max="22"
                    android:progress="1"
                    android:progressBackgroundTint="@color/DCDECA"
                    android:progressTint="@color/DCDECA"
                    android:minHeight="5dp"
                    android:maxHeight="5dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>