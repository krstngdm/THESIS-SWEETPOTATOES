<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/rounded_lock_bg.xml -->
<!-- Dashed border with a subtle off-white/gray fill to signal disabled state -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#F0F2EE" />

    <stroke
        android:width="1.5dp"
        android:color="#C8CBC4"
        android:dashWidth="6dp"
        android:dashGap="4dp" />

    <corners android:radius="12dp" />
</shape>