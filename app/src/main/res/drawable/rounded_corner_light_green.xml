<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid background color -->
    <solid android:color="@color/bg_light_green" /> <!-- Light gray color -->

    <!-- Rounded corners -->
    <corners android:radius="30dp" /> <!-- Adjust radius as needed -->

    <stroke
        android:color="@color/gray"
        android:width="2dp"
        />
    <!-- Optional: Add padding -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>