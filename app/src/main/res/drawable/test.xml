<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bottom_devider" />
            <corners android:radius="50dp" />
        </shape>
    </item>

    <!-- Top inner shadow -->
    <item android:height="10dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1E000000"
                android:endColor="@android:color/transparent"
                android:type="linear" />
            <corners android:radius="0dp" />
        </shape>
    </item>

    <!-- Bottom inner shadow -->
    <item android:height="10dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#1E000000"
                android:endColor="@android:color/transparent"
                android:type="linear" />
            <corners android:radius="0dp"/>
        </shape>
    </item>
</layer-list>