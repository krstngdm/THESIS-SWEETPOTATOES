<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient similar to screenshot -->
    <gradient
        android:startColor="#315732"
        android:endColor="#89A050"
        android:angle="-180" />

    <!-- Rounded corners -->
    <corners android:radius="32dp" />

    <!-- Inner padding effect via inset (optional) -->
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />

    <!-- Optional stroke for subtle border -->
    <stroke
        android:width="1dp"
        android:color="#557A57" />
</shape>
